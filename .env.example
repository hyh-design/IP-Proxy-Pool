# Copy to .env and replace every placeholder secret before starting the API.
IP_POOL_ENVIRONMENT=dev
IP_POOL_REDIS__URL=redis://localhost:6379/0
IP_POOL_REDIS__KEY_PREFIX=ippool:dev
IP_POOL_REDIS__CONNECT_TIMEOUT_SECONDS=2
IP_POOL_REDIS__READ_TIMEOUT_SECONDS=5
IP_POOL_API__HOST=127.0.0.1
IP_POOL_API__PORT=8000
IP_POOL_API__AUTH_ENABLED=true
IP_POOL_API__API_KEYS=["replace-with-a-long-random-read-key"]
IP_POOL_API__ADMIN_API_KEYS=[]
IP_POOL_API__CURSOR_SECRET=replace-with-at-least-32-random-characters
IP_POOL_API__MAX_PAGE_SIZE=200
IP_POOL_API__QUERY_RATE_LIMIT=120
IP_POOL_API__ADMIN_RATE_LIMIT=10
IP_POOL_API__RATE_WINDOW_SECONDS=60
IP_POOL_API__ADMIN_PROBE_ENABLED=false
IP_POOL_API__LEGACY_ROUTES_ENABLED=false
IP_POOL_RECLAIM_QUOTA__ENABLED=false
IP_POOL_RECLAIM_QUOTA__API_KEYS=[]
IP_POOL_PEER_EXPORT__ENABLED=false
IP_POOL_PEER_EXPORT__NODE_ID=
IP_POOL_PEER_EXPORT__API_KEYS=[]
IP_POOL_PEER_EXPORT__RATE_LIMIT=30
IP_POOL_PEER_CACHE__ENABLED=false
IP_POOL_PEER_CACHE__PEER_NAME=
IP_POOL_PEER_CACHE__ORIGIN_NODE=
IP_POOL_PEER_CACHE__BASE_URL=
IP_POOL_PEER_CACHE__API_KEY=
IP_POOL_PEER_CACHE__MIN_SCORE=90
IP_POOL_PEER_CACHE__MAX_LATENCY_MS=2000
IP_POOL_PEER_CACHE__MAX_CHECKED_AGE_SECONDS=600
IP_POOL_PEER_CACHE__MIN_CONSECUTIVE_SUCCESSES=2
IP_POOL_PEER_CACHE__SYNC_INTERVAL_SECONDS=60
IP_POOL_PEER_CACHE__CACHE_TTL_SECONDS=180
IP_POOL_PEER_CACHE__PROXY_COOLDOWN_SECONDS=600
IP_POOL_PEER_CACHE__MAX_ITEMS=20
IP_POOL_COLLECTOR__CONCURRENCY=20
IP_POOL_COLLECTOR__MAX_PAGES_PER_SOURCE=5
IP_POOL_COLLECTOR__MAX_RESPONSE_BYTES=2097152
IP_POOL_COLLECTOR__MAX_PROXIES_PER_SOURCE_ROUND=2000
IP_POOL_COLLECTOR__MAX_POOL_SIZE_PER_DOMAIN=10000
IP_POOL_COLLECTOR__COLLECTION_INTERVAL_SECONDS=300
IP_POOL_COLLECTOR__INVENTORY_CHECK_INTERVAL_SECONDS=60
IP_POOL_COLLECTOR__LOW_INVENTORY_THRESHOLD=20
IP_POOL_COLLECTOR__LOW_INVENTORY_MIN_SCORE=80
IP_POOL_COLLECTOR__LOW_INVENTORY_MAX_LATENCY_MS=2000
IP_POOL_COLLECTOR__LOW_INVENTORY_MAX_NEW_CANDIDATES=500
IP_POOL_CHECKER__CONCURRENCY=100
IP_POOL_CHECKER__BATCH_SIZE=200
IP_POOL_CHECKER__LEASE_SECONDS=60
IP_POOL_CHECKER__REQUEST_TIMEOUT_SECONDS=5
IP_POOL_CHECKER__BREAKER_FAILURES=3
IP_POOL_CHECKER__BREAKER_COOLDOWN_SECONDS=60
IP_POOL_CHECKER__DROP_AFTER_FAILURES=5
IP_POOL_SELECTION__MIN_SCORE=90
IP_POOL_SELECTION__MAX_LATENCY_MS=5000
IP_POOL_SELECTION__MAX_CHECKED_AGE_SECONDS=600
IP_POOL_SELECTION__MIN_CONSECUTIVE_SUCCESSES=2
IP_POOL_SECURITY__ALLOW_NON_GLOBAL_PROXIES=false
IP_POOL_SECURITY__ALLOWED_PROBE_HOSTS=[]
IP_POOL_SECURITY__ALLOW_REDIRECTS=false
IP_POOL_SECURITY__BLOCKED_PROXY_NETWORKS=["173.245.48.0/20","103.21.244.0/22","103.22.200.0/22","103.31.4.0/22","141.101.64.0/18","108.162.192.0/18","190.93.240.0/20","188.114.96.0/20","197.234.240.0/22","198.41.128.0/17","162.158.0.0/15","104.16.0.0/13","104.24.0.0/14","172.64.0.0/13","131.0.72.0/22"]
IP_POOL_OBSERVABILITY__LOG_LEVEL=INFO
IP_POOL_OBSERVABILITY__JSON_LOGS=true
IP_POOL_OBSERVABILITY__METRICS_ENABLED=true
IP_POOL_DASHBOARD__ENABLED=true
IP_POOL_DASHBOARD__SNAPSHOT_INTERVAL_SECONDS=300
IP_POOL_DASHBOARD__SHORT_RETENTION_HOURS=48
IP_POOL_DASHBOARD__LONG_RETENTION_HOURS=720
IP_POOL_DASHBOARD__HEARTBEAT_INTERVAL_SECONDS=30
