IP_POOL_TARGET__DOMAIN=httpbin.org
IP_POOL_TARGET__EXPECTED_STATUSES=[200]
IP_POOL_TARGET__EXPECTED_TEXT=
IP_POOL_TARGET__JSON_KEYS=["origin"]
IP_POOL_TARGET__TIMEOUT_SECONDS=5
IP_POOL_TARGET__VALIDATION_TARGETS=[{"name":"ipip","url":"https://myip.ipip.net/json","expected_statuses":[200],"json_keys":["data"],"timeout_seconds":5}]
